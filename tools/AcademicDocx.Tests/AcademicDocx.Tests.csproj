<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../AcademicDocx.Core/AcademicDocx.Core.csproj" />
    <None Include="../../quarto/_extensions/academic/academic.docx" Link="reference.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../quarto/_extensions/academic/profiles.json" Link="profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/**/*.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../quarto/_extensions/academic/page-templates/sto04/*.xml" Link="PageTemplates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
