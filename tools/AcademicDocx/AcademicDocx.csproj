<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>academic-docx</AssemblyName>
    <Version>0.4.6</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup Condition="'$(WordPiaPath)' == ''">
    <WordPiaCandidate Include="$(MSBuildProgramFiles32)/Microsoft Visual Studio/Shared/Visual Studio Tools for Office/PIA/Microsoft.Office.Interop.Word.dll" Condition="Exists('$(MSBuildProgramFiles32)/Microsoft Visual Studio/Shared/Visual Studio Tools for Office/PIA/Microsoft.Office.Interop.Word.dll')" />
    <WordPiaCandidate Include="$(ProgramW6432)/Microsoft Visual Studio/Shared/Visual Studio Tools for Office/PIA/Microsoft.Office.Interop.Word.dll" Condition="Exists('$(ProgramW6432)/Microsoft Visual Studio/Shared/Visual Studio Tools for Office/PIA/Microsoft.Office.Interop.Word.dll')" />
    <WordPiaCandidate Include="$(windir)/assembly/GAC_MSIL/Microsoft.Office.Interop.Word/*/Microsoft.Office.Interop.Word.dll" />
  </ItemGroup>
  <PropertyGroup Condition="'$(WordPiaPath)' == ''">
    <WordPiaPath>@(WordPiaCandidate->'%(FullPath)')</WordPiaPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(OfficePiaPath)' == ''">
    <OfficePiaCandidate Include="$(MSBuildProgramFiles32)/Microsoft Visual Studio/Shared/Visual Studio Tools for Office/PIA/office.dll" Condition="Exists('$(MSBuildProgramFiles32)/Microsoft Visual Studio/Shared/Visual Studio Tools for Office/PIA/office.dll')" />
    <OfficePiaCandidate Include="$(windir)/assembly/GAC_MSIL/office/*/OFFICE.DLL" />
  </ItemGroup>
  <PropertyGroup Condition="'$(OfficePiaPath)' == ''">
    <OfficePiaPath>@(OfficePiaCandidate->'%(FullPath)')</OfficePiaPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../licenses/OpenXML.txt" Link="licenses/OpenXML.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../licenses/Spectre.Console.txt" Link="licenses/Spectre.Console.txt" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <ProjectReference Include="../AcademicDocx.Core/AcademicDocx.Core.csproj" />
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>$(WordPiaPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="office">
      <HintPath>$(OfficePiaPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireWordPia" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(WordPiaPath)')" Text="Official Word PIA not found uniquely. Install the Office development assemblies or set -p:WordPiaPath=path/to/Microsoft.Office.Interop.Word.dll. Do not use an unsupported NuGet repackaging." />
    <Error Condition="!Exists('$(OfficePiaPath)')" Text="Official Office core PIA not found uniquely. Install the Office development assemblies or set -p:OfficePiaPath=path/to/office.dll. It is required for native page shapes." />
  </Target>
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RedistributedRuntime Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <RuntimeNotice Include="@(RedistributedRuntime->'%(PackageDirectory)/LICENSE.TXT');@(RedistributedRuntime->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeNotice)" DestinationFolder="$(PublishDir)licenses/dotnet" SkipUnchangedFiles="true" />
  </Target>
</Project>
